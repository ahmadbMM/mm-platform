{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The F&B partner portal: restaurants and cafes sign in and reserve the Saturdays our riders
  // come to them for breakfast. A Worker of its own, apart from the website (apps/web), so it
  // stays small and never shares the website's bundle or cookies.
  //
  // NO ADDRESS YET: the subdomain (for example partners.micromobility.sa) is not decided. Until it
  // is, a deploy answers on its workers.dev address only. When it is decided, add here (and in
  // env.staging for staging's own name):
  //   "routes": [{ "pattern": "partners.micromobility.sa", "custom_domain": true }]
  // The app works on any host: the cookie is host-only and every call is same-origin.
  //
  // CI deploys this (production, the top level) only while the repository variable MM_PARTNERS
  // is "on" and the Cloudflare secrets exist (.github/workflows/ci.yml).
  "name": "micromobility-partners",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  // dist/ is what scripts/build.mjs writes: the page, its script and styles, the fonts.
  // run_worker_first: every answer, files included, goes through the Worker for its headers.
  "assets": { "directory": "dist", "binding": "ASSETS", "run_worker_first": true },
  "workers_dev": true,
  // Sign-in tries per connection: 10 a minute (src/worker/index.ts, withinTries). The website
  // uses namespaces 1001/1002; these are the portal's own. Bindings are not inherited by env.
  "ratelimits": [{ "name": "LOGIN_LIMIT", "namespace_id": "1101", "simple": { "limit": 10, "period": 60 } }],
  "observability": { "enabled": true },
  // The production database (Frankfurt). The anon key is public by design: it is the same key the
  // website and the registration forms ship to every browser. What protects the data is that the
  // portal's functions check the venue's token (the migration 20261003150000_fnb_partners.sql).
  "vars": {
    "SUPABASE_URL": "https://qpffkzmsfyilicwcsszz.supabase.co",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFwZmZrem1zZnlpbGljd2Nzc3p6Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTAyNDQwODAsImV4cCI6MjEwNTgyMDA4MH0.K6qZpK0oR4MXIaFk4DRJGy-H_m6BYnJ-S31swTiHMhQ"
  },
  "env": {
    // `wrangler deploy --env staging`: the same portal against the staging database.
    "staging": {
      "name": "micromobility-partners-staging",
      "workers_dev": true,
      "assets": { "directory": "dist", "binding": "ASSETS", "run_worker_first": true },
      "ratelimits": [{ "name": "LOGIN_LIMIT", "namespace_id": "1102", "simple": { "limit": 10, "period": 60 } }],
      "observability": { "enabled": true },
      "vars": {
        "SUPABASE_URL": "https://jkfhiszcnuvoftvkzaye.supabase.co",
        // The staging project's legacy anon key (public by design, like production's).
        "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImprZmhpc3pjbnV2b2Z0dmt6YXllIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTA5NjEyNjIsImV4cCI6MjEwNjUzNzI2Mn0.2FIh9SWxZXutONZQfPruTR95GJ5nGXosZVArnsys_bw"
      }
    }
  }
}
