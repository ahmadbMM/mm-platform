{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The vendor portal: restaurants and cafes sign in and reserve the Saturdays our riders
  // come to them for breakfast. A Worker of its own, apart from the website (apps/web), so it
  // stays small and never shares the website's bundle or cookies.
  //
  // ADDRESS: vendors.micromobility.sa (the owner's choice, 2026-10-03), claimed as a Workers
  // custom domain, so Cloudflare makes its DNS record on the first deploy (the name had none).
  // Staging stays on its workers.dev address. Rollback = remove the route and redeploy.
  // The app works on any host: the cookie is host-only and every call is same-origin.
  //
  // CI deploys this (production, the top level) only while the repository variable MM_VENDORS
  // is "on" and the Cloudflare secrets exist (.github/workflows/ci.yml).
  //
  // Worker names micromobility-vendors / micromobility-vendors-staging (renamed from
  // micromobility-partners on 2026-10-03: the old Worker was deleted in the dashboard first, as a new
  // name is a NEW Worker and the custom domain can be attached to only one).
  "name": "micromobility-vendors",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  // dist/ is what scripts/build.mjs writes: the page, its script and styles, the fonts.
  // run_worker_first: every answer, files included, goes through the Worker for its headers.
  // not_found_handling: an address the portal does not have answers 404 with dist/404.html (it was
  // a 404 with an empty body, a blank page).
  "assets": { "directory": "dist", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "404-page" },
  "workers_dev": true,
  "routes": [{ "pattern": "vendors.micromobility.sa", "custom_domain": true }],
  // Sign-in tries per connection: 10 a minute (src/worker/index.ts, withinTries). The website
  // uses namespaces 1001/1002; these are the portal's own. Bindings are not inherited by env.
  "ratelimits": [{ "name": "LOGIN_LIMIT", "namespace_id": "1101", "simple": { "limit": 10, "period": 60 } }],
  "observability": { "enabled": true },
  // SECRET (not a var, never written here): VENDOR_GATE_SECRET. When set, the sign-in call sends it as
  // the x-vendor-gate header; the database refuses sign-in without it once the owner stores its sha256
  // in public.vendor_gate (rentals migration 20261004130000 has the steps). Set it with
  //   npx wrangler secret put VENDOR_GATE_SECRET               (production)
  //   npx wrangler secret put VENDOR_GATE_SECRET --env staging (staging)
  // Unset, the portal signs in as before. Secrets are per environment and survive deploys.
  // The production database (Frankfurt). The anon key is public by design: it is the same key the
  // website and the registration forms ship to every browser. What protects the data is that the
  // portal's functions check the venue's token (the migration 20261003150000_fnb_partners.sql in the rentals
  // repo, which first named them fnb_*; they are vendor_* now).
  "vars": {
    "SUPABASE_URL": "https://qpffkzmsfyilicwcsszz.supabase.co",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFwZmZrem1zZnlpbGljd2Nzc3p6Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTAyNDQwODAsImV4cCI6MjEwNTgyMDA4MH0.K6qZpK0oR4MXIaFk4DRJGy-H_m6BYnJ-S31swTiHMhQ"
  },
  "env": {
    // `wrangler deploy --env staging`: the same portal against the staging database.
    "staging": {
      "name": "micromobility-vendors-staging",
      "workers_dev": true,
      "assets": { "directory": "dist", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "404-page" },
      "ratelimits": [{ "name": "LOGIN_LIMIT", "namespace_id": "1102", "simple": { "limit": 10, "period": 60 } }],
      "observability": { "enabled": true },
      "vars": {
        "SUPABASE_URL": "https://jkfhiszcnuvoftvkzaye.supabase.co",
        // The staging project's legacy anon key (public by design, like production's).
        "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImprZmhpc3pjbnV2b2Z0dmt6YXllIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTA5NjEyNjIsImV4cCI6MjEwNjUzNzI2Mn0.2FIh9SWxZXutONZQfPruTR95GJ5nGXosZVArnsys_bw"
      }
    }
  }
}
