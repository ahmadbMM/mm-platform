# Headers for the files Cloudflare serves straight from the Worker's static assets (they never
# reach the site's code, so next.config headers() does not apply to them).
#
# Next's build files carry a hash in their name - a new build writes new names - so a browser may
# keep them for a year. They were sent with max-age=0 and downloaded again on every page.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The site's own photos and logos keep their names across builds; a day is safe.
/site/*
  Cache-Control: public, max-age=86400

# The city lists the account form offers (the booking app's own data); they change only when refreshed.
/cities/*
  Cache-Control: public, max-age=86400

# The push service worker (public/sw.js) must be checked for a new version on every visit, or a
# fix to it would wait for the browser's own 24-hour check.
/sw.js
  Cache-Control: no-cache

# The registration forms' fonts (forms/*/design/styles.css): plain names that stay across builds,
# so a week rather than a year.
/fonts/forms/*
  Cache-Control: public, max-age=604800
