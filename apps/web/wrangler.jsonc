{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Default target = the PREVIEW Worker: a workers.dev address, no claim on the domain.
  // Every push to main deploys this one.
  "name": "micromobility-web-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "workers_dev": true,
  "env": {
    // `wrangler deploy --env production` = the real site. It answers micromobility.sa by
    // ROUTE, not custom domain, on purpose: the DNS records stay as they are (proxied A
    // records at the old host) and the Petromin worker's more specific /petromin* route
    // keeps winning for that path.
    //
    // The route is deliberately NARROW for now. `/b/*` is the NFC bike pages and nothing
    // else, so the bike stickers go live on the real domain while the root keeps forwarding
    // to the Salla store. A Worker route runs before that forward, so widening this list is
    // what actually claims the site — do it when the full site is ready, by replacing the
    // /b/* entry with:
    //   { "pattern": "micromobility.sa/*",     "zone_name": "micromobility.sa" },
    //   { "pattern": "www.micromobility.sa/*", "zone_name": "micromobility.sa" }
    // The chips keep holding /b/42 either way; nothing has to be rewritten at cutover.
    //
    // CI only runs this once the repository variable MM_PRODUCTION is set to "on".
    "production": {
      "name": "micromobility-web",
      "workers_dev": false,
      "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
      // /_next/* is not optional and cannot be moved: Next serves its own CSS, JavaScript and
      // self-hosted fonts from there, at the root, whatever path the page itself lives on.
      // Without this route those bundles fall through to the old forward and answer 302 to the
      // store, which renders the bike page as unstyled HTML with no script. /b/assets is ours
      // and stays inside /b/* on purpose, so this is the only extra prefix the site claims.
      "routes": [
        { "pattern": "micromobility.sa/b/*",         "zone_name": "micromobility.sa" },
        { "pattern": "www.micromobility.sa/b/*",     "zone_name": "micromobility.sa" },
        { "pattern": "micromobility.sa/_next/*",     "zone_name": "micromobility.sa" },
        { "pattern": "www.micromobility.sa/_next/*", "zone_name": "micromobility.sa" }
      ]
    }
  }
  // Later: NEXT_INC_CACHE_R2_BUCKET binding for ISR caching (see OpenNext caching docs)
}
