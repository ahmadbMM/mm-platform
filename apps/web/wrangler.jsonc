{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Default target = the PREVIEW Worker: a workers.dev address, no claim on the domain.
  // Every push to main deploys this one.
  "name": "micromobility-web-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "workers_dev": true,
  "env": {
    // `wrangler deploy --env production` = the real site. It answers the root and www of
    // micromobility.sa by ROUTE, not custom domain, on purpose: the DNS records stay as they
    // are (proxied A records at the old host), the Petromin worker's more specific route on
    // /petromin* keeps winning for that path, and a Worker route runs before the old forward
    // to the store, so that forward stops applying at the first production deploy.
    // CI only runs this once the repository variable MM_PRODUCTION is set to "on".
    "production": {
      "name": "micromobility-web",
      "workers_dev": false,
      "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
      "routes": [
        { "pattern": "micromobility.sa/*",     "zone_name": "micromobility.sa" },
        { "pattern": "www.micromobility.sa/*", "zone_name": "micromobility.sa" }
      ]
    }
  }
  // Later: NEXT_INC_CACHE_R2_BUCKET binding for ISR caching (see OpenNext caching docs)
}
