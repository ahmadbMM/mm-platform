{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The default target is only ever deployed BY HAND (`npx wrangler deploy` from apps/web): a copy
  // of the site on a workers.dev address, with no claim on the domain, to look at before a push. CI
  // never deploys it - the automatic preview went on 2026-09-20 (DEPLOY.md, "Deploys") - and
  // deploys `production` below instead.
  "name": "micromobility-web-preview",
  // worker.js: the front (edge/front.js) and the site OpenNext builds (.open-next/worker.js) in one Worker, for the
  // preview; production and staging run them apart (below).
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "workers_dev": true,
  // Sign-in tries per connection (src/lib/sign-in-guard.ts): 10 a minute; page-error reports and the
  // signed-in pop-ups' checks (src/lib/rate-limit.ts): 30 of each a minute. Bindings are not
  // inherited, so production and staging repeat them.
  "ratelimits": [
    { "name": "LOGIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "API_LIMIT", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } }
  ],
  // This deploy's id: the edge page cache keeps each deploy's pages apart (src/lib/page-cache.ts).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Workers Logs: what the Worker writes (the page-error reports from /api/log-error, failures)
  // is kept and searchable in the dashboard (Workers & Pages > micromobility-web > Logs).
  "observability": { "enabled": true },
  "env": {
    // Production and staging run the site in two Workers (the user, 2026-11-09: the first visit after a quiet spell took
    // up to 2.5 s, most of it this 23 MB Worker starting on a cold machine even to send a kept page):
    //   - the front (edge.js, wrangler.edge.jsonc): micromobility-web / micromobility-web-staging, which hold the
    //     addresses and answer from the edge's page copies at once;
    //   - the site (site.js, this file): micromobility-web-site / micromobility-web-staging-site, with no address of
    //     its own, asked by the front through a service binding.
    // CI deploys the site first, then the front (`wrangler deploy --env production`, then
    // `wrangler deploy -c wrangler.edge.jsonc --env production`). Rollback: deploy a commit from before 2026-11-10, whose
    // micromobility-web was both in one; the site Worker is then left unused.
    //
    // `--env production` = the site of micromobility.sa. CI only runs this while the repository variable MM_PRODUCTION
    // is "on". The routes that answer the whole domain (both hosts, by ROUTE, not custom domain: the DNS records stay at
    // the old host, where company email lives) are the front's (wrangler.edge.jsonc). The registration forms and the
    // fleet's NFC tag pages are ordinary paths of the site.
    "production": {
      "name": "micromobility-web-site",
      "main": "site.js",
      "workers_dev": false,
      "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
      "ratelimits": [
        { "name": "LOGIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
        { "name": "API_LIMIT", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } }
      ],
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "observability": { "enabled": true }
    },
    // `--env staging` = the site of staging.micromobility.sa, deployed by CI from the `staging` branch, built against
    // the staging database (repository variables STAGING_SUPABASE_URL / STAGING_SUPABASE_ANON_KEY), never production's.
    // Its front (wrangler.edge.jsonc) holds the custom domain, behind Cloudflare Access.
    "staging": {
      "name": "micromobility-web-staging-site",
      "main": "site.js",
      "workers_dev": false,
      "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
      "ratelimits": [
        { "name": "LOGIN_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
        { "name": "API_LIMIT", "namespace_id": "1004", "simple": { "limit": 30, "period": 60 } }
      ],
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "observability": { "enabled": true },
      "vars": { "MM_ENV": "staging" },
      // Online payments' reconcile run (site.js scheduled; src/app/api/pay/reconcile). Production gets the same line
      // when payments open there. The keys are this Worker's secrets (src/lib/pay/config.ts).
      "triggers": { "crons": ["*/5 * * * *"] }
    }
  }
  // Later: NEXT_INC_CACHE_R2_BUCKET binding for ISR caching (see OpenNext caching docs)
}
