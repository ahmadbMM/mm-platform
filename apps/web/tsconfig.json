{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "es2022"], "module": "esnext",
    "moduleResolution": "bundler", "jsx": "preserve", "strict": true,
    "skipLibCheck": true, "noEmit": true, "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
